# Copy this file to .env and fill in your MongoDB Atlas connection string.
# Atlas -> Clusters -> Connect -> Drivers -> copy the URI and replace <db_password>.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sample_restaurants
# Restaurants imported from Zomato by restaurants.india.ZomatoImporter
MONGODB_COLLECTION=india_restaurants
# PORT=8080
